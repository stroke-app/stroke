{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stroke",
  "version": "2.2.4",
  "identifier": "com.broisnischal.stroke",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyODEwMzlFQTA0NjgwRjkKUldUNWdFYWduZ09CRXZvdFpXNWx2V2lFSUlaaXRPV1ptdXlpNXpuU3l0QWpvLzVvTzZZdTlTdUEK",
      "endpoints": [
        "https://github.com/stroke-app/stroke/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "dialog": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "template": "./nsis/installer.nsi",
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
