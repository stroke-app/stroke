# Maintainer: broisnees
# Generated by .github/workflows/release.yml (update-aur) on each stable
# release; @VERSION@ and @SHA256@ are filled in there.
pkgname=stroke-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Native database client for PostgreSQL, MySQL, SQLite, MongoDB, Redis and more, with an AI agent and an MCP server"
arch=('x86_64')
url="https://stroke.click"
license=('LicenseRef-Stroke')
depends=('webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme')
provides=('stroke')
conflicts=('stroke')
options=('!strip' '!debug')
source=("stroke-${pkgver}.deb::https://github.com/stroke-app/stroke/releases/download/v${pkgver}/stroke_${pkgver}_amd64.deb"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/stroke-app/stroke/v${pkgver}/LICENSE")
sha256sums=('@SHA256@'
            'SKIP')

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir"

  # The .deb names its binary and icon "app"; on Arch that would collide with
  # anything else called app, so both become "stroke".
  mv "$pkgdir/usr/bin/app" "$pkgdir/usr/bin/stroke"
  for icon in "$pkgdir"/usr/share/icons/hicolor/*/apps/app.png; do
    mv "$icon" "${icon%/app.png}/stroke.png"
  done
  sed -i -e 's/^Exec=app$/Exec=stroke/' \
         -e 's/^Icon=app$/Icon=stroke/' \
         -e 's/^StartupWMClass=app$/StartupWMClass=stroke/' \
         -e 's/^Categories=$/Categories=Development;Database;/' \
         "$pkgdir/usr/share/applications/Stroke.desktop"

  install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
